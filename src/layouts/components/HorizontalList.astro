---
/**
 * Soporta dos formas de props:
 *   <HorizontalList insumos={...} />
 *   <HorizontalList data={...} />
 * Estructura esperada:
 *   { title: string; description?: string; items?: { title: string; image: string; link?: string }[] }
 */
type Item = {
  title: string;
  image: string;
  link?: string;
  brands?: string[];
  description?: string;
};
type Block = { title?: string; description?: string; items?: Item[] };
type Brand = string | { name: string; logo?: string };

const { insumos, data } = Astro.props as { insumos?: Block; data?: Block };

import config from "@/config/config.json";
import { WhatsappLogo } from "phosphor-react";
const whatsAppLink = `${config.params.whatsAppLink}?text=${config.params.whatsAppMessage}`;
const block: Block = insumos ?? data ?? {};
const title = block?.title ?? "Insumos";
const description = block?.description ?? "";
const items: Item[] = Array.isArray(block?.items)
  ? (block!.items as Item[])
  : [];
const FALLBACK_IMG = "/images/placeholder.jpg";

const normalizeBrands = (brands?: Brand[]) =>
  (brands ?? []).map((b) => (typeof b === "string" ? { name: b } : b));
---

<section class="px-4 py-12 md:py-16 lg:py-20">
  <div class="container">
    <div class="max-w-3xl">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold">{title}</h2>
      {description && <p class="mt-3 text-gray-600">{description}</p>}
    </div>

    {
      items.length > 0 ? (
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((it) => (
            <div class="group rounded-lg overflow-hidden shadow-sm hover:shadow-md transition border border-accent">
              <div class="relative">
                <a
                  href={it.link || "#"}
                  aria-label={`Ver ${it.title ?? "item"}`}
                  class="block"
                >
                  <img
                    src={it.image ?? FALLBACK_IMG}
                    alt={it.title ?? "insumo"}
                    loading="lazy"
                    class="w-full aspect-[16/9] object-cover"
                  />
                </a>
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3">
                  <h3 class="text-lg font-semibold">
                    {it.title ?? "Insumo"}
                  </h3>
                </div>
              </div>
              <div class="p-4 flex flex-col gap-3">
                {it.description && (
                  <p class="text-sm text-gray-700">{it.description}</p>
                )}

                {it.brands && it.brands.length > 0 && (
                  <p class="text-xs text-gray-500">
                    <span class="font-medium">Marcas: </span>
                    {it.brands.join(", ")}
                  </p>
                )}

                <a
                  href={`${whatsAppLink}${encodeURIComponent(" " + (it.title ?? ""))}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp"
                  aria-label={`Consultar por WhatsApp sobre ${it.title ?? "este insumo"}`}
                >
                  <WhatsappLogo size={18} className="text-black" />
                  Consultar por {it.title ?? "este insumo"}
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-gray-500">No hay insumos para mostrar.</p>
      )
    }

    <div class="mt-10 flex justify-center">
      <a
        href={whatsAppLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp"
      >
        <WhatsappLogo size={22} className="text-black" />
        ¿Tenés dudas? Escribinos por WhatsApp
      </a>
    </div>
  </div>
</section>
