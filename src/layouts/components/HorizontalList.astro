---
/**
 * Soporta:
 *   <HorizontalList insumos={...} />
 *   <HorizontalList data={...} />
 * items[]: { title, key, image, link?, description?, brands?: (string | {name, logo?})[] }
 */
type Brand = string | { name: string; logo?: string };
type Item = {
  title: string;
  key: string;
  image: string;
  link?: string;
  brands?: Brand[];
  description?: string;
};
type Block = { title?: string; key?: string; description?: string; items?: Item[] };

const { insumos, data } = Astro.props as { insumos?: Block; data?: Block };

import config from "@/config/config.json";
import { WhatsappLogo } from "phosphor-react";

const FALLBACK_IMG = "/images/placeholder.jpg";
const block: Block = insumos ?? data ?? {};
const title = block?.title ?? "Insumos";
const description = block?.description ?? "";
const items: Item[] = Array.isArray(block?.items) ? (block!.items as Item[]) : [];

// Normaliza brands a objetos { name, logo? }
const normalizeBrands = (brands?: Brand[]) =>
  (brands ?? []).map((b) => (typeof b === "string" ? { name: b } : b));

// WhatsApp
const whatsAppBase = config.params.whatsAppLink;
const whatsAppMsg = config.params.whatsAppMessage;
// CTA global
const whatsAppLink = `${whatsAppBase}?text=${whatsAppMsg}`;
---

<section class="px-4 py-12 md:py-16 lg:py-20">
  <div class="container">
    <div class="max-w-3xl">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold">{title}</h2>
      {description && <p class="mt-3 text-gray-600">{description}</p>}
    </div>

    {items.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((it) => {
          const brands = normalizeBrands(it.brands);
          return (
            <div class="group rounded-lg overflow-hidden shadow-sm hover:shadow-md transition border border-accent/80">
              <div class="relative">
                  <img
                    src={it.image ?? FALLBACK_IMG}
                    alt={it.title ?? "insumo"}
                    loading="lazy"
                    class="w-full aspect-[16/9] object-cover"
                  />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-dark/70 to-dark/5 p-3 pb-1">
                  <h3 class="text-lg font-semibold">{it.title ?? "Insumo"}</h3>
                </div>
              </div>

              <div class="p-4 flex flex-col gap-3">
                {it.description && <p class="text-sm text-gray-700">{it.description}</p>}

                {brands.length > 0 && (
                  <div class="mt-1 mb-2 flex flex-wrap gap-2">
                    {brands.map((b) => (
                      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-[#162B3A]/60 text-[#E0F7FF] text-xs font-medium">
                        {b.logo ? (
                          <img src={b.logo} alt={b.name} class="h-4 w-auto object-contain" loading="lazy" />
                        ) : null}
                        {b.name}
                      </span>
                    ))}
                  </div>
                )}

                <a
                  href={`${whatsAppBase}?text=${whatsAppMsg}${encodeURIComponent(" " + (it.title.toLowerCase() ?? ""))}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-whatsapp_outline mt-1 w-fit"
                  aria-label={`Consultar por WhatsApp sobre ${it.title ?? "este insumo"}`}
                >
                  <WhatsappLogo size={20} className="text-dark" />
                  Consultar por {(it.title ?? "este insumo").toLowerCase()}
                </a>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="mt-6 text-gray-500">No hay insumos para mostrar.</p>
    )}

    <!-- <div class="mt-10 flex justify-center">
      <a href={whatsAppLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
        <WhatsappLogo size={22} className="text-black" />
        ¿Tenés dudas? Escribinos por WhatsApp
      </a>
    </div> -->
  </div>
</section>
