---
import CardExtension from "@/layouts/function-components/CardExtension";
import * as PhosphorIcons from "phosphor-react";

const { card, benefits } = Astro.props;

// Tercer bloque (Comunicaciones) con fallback seguro
const comm = card?.list?.[2];
---
<section class="infra py-16">
  <div class="container">
    <!-- Encabezado -->
    <header class="mb-10 text-left">
      <!-- Si quieres mostrar el título general de la sección, descomenta la línea de abajo -->
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight">Infraestructura</h2>
      <div class="mt-2 h-1 w-16 rounded bg-secondary mx-0"></div>
    </header>

    {card?.list && card.list.length > 0 ? (
      <div class="flex flex-col gap-10">
        
        <div
          class="grid grid-cols-1 gap-6 md:grid-cols-2"
          role="list"
          aria-label="Bloques de infraestructura"
        >
          {card.list.slice(0, 2).map((item, index) => (
            <div
              role="listitem"
              class="rounded-xl border border-border bg-white p-6 transition"
            >
              <CardExtension
                key={index}
                title={item.title}
                description={item.description}
              />
            </div>
          ))}
        </div>

        {comm && (
          <section
            class="rounded-xl border border-border bg-white p-6 md:p-8 "
            aria-labelledby="infra-comm-title"
          >
            <header class="mb-4">
              <h3
                id="infra-comm-title"
                class="text-xl md:text-2xl font-semibold tracking-tight"
              >
                {comm.title}
              </h3>
              {comm.description && (
                <p class="mt-2 text-[15px] leading-relaxed text-dark/80">
                  {comm.description}
                </p>
              )}
            </header>

            <div class="my-4 h-px w-full bg-border"></div>

            {benefits?.list && benefits.list.length > 0 && (
              <div aria-labelledby="infra-comm-benefits">
                <h4
                  id="infra-comm-benefits"
                  class="text-sm  text-dark/70 mb-3"
                >
                  {benefits?.description ?? "Beneficios para tu empresa"}
                </h4>

                <ul
                  class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3"
                  role="list"
                >
                  {benefits.list.map((benefit, i) => {
                    const IconComponent =
                      PhosphorIcons[benefit.icon] ?? PhosphorIcons.Question;

                    return (
                      <li
                        key={`benefit-${i}`}
                        role="listitem"
                        class="flex items-center gap-3 rounded-lg bg-theme-light/30 p-4"
                      >
                        <div class="shrink-0 rounded-full  p-2 text-primary">
                          <IconComponent size={20} weight="regular" />
                          <span class="sr-only">Ícono</span>
                        </div>
                        <span class="text-sm font-semibold leading-6 text-dark">
                          {benefit.title}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}
          </section>
        )}
      </div>
    ) : (
      <p class="text-dark/70">No hay datos para mostrar.</p>
    )}
  </div>
</section>
