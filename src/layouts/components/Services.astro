---
import TestimonialSlider from "@/layouts/function-components/TestimonialSlider";
const { testimonial } = Astro.props;
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
---

<section class="reviews section" id="servicios">
  <div class="container">
    <header class="max-w-3xl">
      <h2
        class="text-2xl md:text-3xl font-bold"
        set:html={markdownify(testimonial.title)}
      />
      <div class="mt-4 h-1 w-16 rounded bg-secondary "></div>
    </header>
    <TestimonialSlider list={testimonial.testimonial_list} />
    <div class="container">
      <Image
        class="w-full object-contain mt-8"
        alt="banner"
        loading="lazy"
        src="/images/banner.png"
        width={603}
        height={396}
      />
    </div>
  </div>
</section>

